<?xml version="1.0"?>
<Actions>
	<Action id="lcdClear" deviceFilter="self.lcd" uiPath="DeviceActions">
		<Name>Clear LCD</Name>
		<CallbackMethod>lcdClear</CallbackMethod>
	</Action>
	<Action id="lcdStartAnimation" deviceFilter="self.lcd" uiPath="DeviceActions">
		<Name>Set LCD display</Name>
		<CallbackMethod>lcdSetDisplay</CallbackMethod>
		<ConfigUI>
			<Field id="lineCount" type="textfield" defaultValue="0" hidden="true"/>
			<Field id="animationLayout" type="textfield" defaultValue="unsupported" hidden="true"/>
			<Field id="staticOverflowLayout" type="textfield" defaultValue="hidden" hidden="true"/>
			<Field id="graphicLineLayout" type="textfield" defaultValue="graphic8" hidden="true"/>
			<Field id="animationMode" type="menu" defaultValue="static">
				<Label>Display mode:</Label>
				<List><Option value="static">Static</Option><Option value="marquee">Marquee — independent rows</Option><Option value="virtualMarquee">Virtual single-line marquee</Option><Option value="flash">Flash / alternate</Option></List>
				<CallbackMethod>lcdAnimationConfigChanged</CallbackMethod>
			</Field>
			<Field id="unsupportedAnimation" type="label" visibleBindingId="animationLayout" visibleBindingValue="unsupported" alwaysUseInDialogHeightCalc="true"><Label>Marquee and Flash currently require a text LCD.</Label></Field>
			<Field id="animationLine1" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="static1,static2,static3,static4,marquee1,marquee2,marquee3,marquee4,flash1,flash2,flash3,flash4" alwaysUseInDialogHeightCalc="true"><Label>Line 1:</Label><CallbackMethod>lcdAnimationConfigChanged</CallbackMethod></Field>
			<Field id="animationLine2" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="static2,static3,static4,marquee2,marquee3,marquee4,flash2,flash3,flash4" alwaysUseInDialogHeightCalc="true"><Label>Line 2:</Label><CallbackMethod>lcdAnimationConfigChanged</CallbackMethod></Field>
			<Field id="animationLine3" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="static3,static4,marquee3,marquee4,flash3,flash4" alwaysUseInDialogHeightCalc="true"><Label>Line 3:</Label><CallbackMethod>lcdAnimationConfigChanged</CallbackMethod></Field>
			<Field id="animationLine4" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="static4,marquee4,flash4" alwaysUseInDialogHeightCalc="true"><Label>Line 4:</Label><CallbackMethod>lcdAnimationConfigChanged</CallbackMethod></Field>
			<Field id="staticOverflowBehavior" type="menu" defaultValue="truncate" visibleBindingId="staticOverflowLayout" visibleBindingValue="show,marquee" alwaysUseInDialogHeightCalc="true"><Label>Overflow behavior:</Label><List><Option value="truncate">Truncate</Option><Option value="marquee">Marquee if needed</Option><Option value="reject">Reject if too long</Option></List><CallbackMethod>lcdAnimationConfigChanged</CallbackMethod></Field>
			<Field id="overflowMarqueeDirection" type="menu" defaultValue="left" visibleBindingId="staticOverflowLayout" visibleBindingValue="marquee" alwaysUseInDialogHeightCalc="true"><Label>Overflow direction:</Label><List><Option value="left">Left</Option><Option value="right">Right</Option></List></Field>
			<Field id="overflowMarqueeGap" type="textfield" defaultValue="3" visibleBindingId="staticOverflowLayout" visibleBindingValue="marquee" alwaysUseInDialogHeightCalc="true"><Label>Overflow repeat gap:</Label></Field>
			<Field id="overflowMarqueeInterval" type="textfield" defaultValue="0.4" visibleBindingId="staticOverflowLayout" visibleBindingValue="marquee" alwaysUseInDialogHeightCalc="true"><Label>Overflow interval (seconds):</Label></Field>
			<Field id="virtualText" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="virtualMarquee1,virtualMarquee2,virtualMarquee3,virtualMarquee4" alwaysUseInDialogHeightCalc="true"><Label>Text:</Label><CallbackMethod>lcdAnimationConfigChanged</CallbackMethod></Field>
			<Field id="virtualTextStatus" type="textfield" readonly="true" defaultValue="∅ empty" visibleBindingId="animationLayout" visibleBindingValue="virtualMarquee1,virtualMarquee2,virtualMarquee3,virtualMarquee4" alwaysUseInDialogHeightCalc="true"><Label>Stored text:</Label></Field>
			<Field id="virtualMarqueeHelp" type="label" visibleBindingId="animationLayout" visibleBindingValue="virtualMarquee1,virtualMarquee2,virtualMarquee3,virtualMarquee4" alwaysUseInDialogHeightCalc="true"><Label>Uses every row as one continuous line. Left enters at the lower right; Right enters at the upper left.</Label></Field>
			<Field id="graphicFont" type="menu" defaultValue="4" visibleBindingId="animationLayout" visibleBindingValue="static0" alwaysUseInDialogHeightCalc="true"><Label>Font:</Label><List><Option value="4">5 × 8 — 8 lines</Option><Option value="3">6 × 10 — 6 lines</Option><Option value="5">6 × 12 — 5 lines</Option></List><CallbackMethod>lcdAnimationConfigChanged</CallbackMethod></Field>
			<Field id="graphicLine1" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="static0" alwaysUseInDialogHeightCalc="true"><Label>Line 1:</Label></Field>
			<Field id="graphicLine2" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="static0" alwaysUseInDialogHeightCalc="true"><Label>Line 2:</Label></Field>
			<Field id="graphicLine3" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="static0" alwaysUseInDialogHeightCalc="true"><Label>Line 3:</Label></Field>
			<Field id="graphicLine4" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="static0" alwaysUseInDialogHeightCalc="true"><Label>Line 4:</Label></Field>
			<Field id="graphicLine5" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="static0" alwaysUseInDialogHeightCalc="true"><Label>Line 5:</Label></Field>
			<Field id="graphicLine6" type="textfield" visibleBindingId="graphicLineLayout" visibleBindingValue="graphic6,graphic8" alwaysUseInDialogHeightCalc="true"><Label>Line 6:</Label></Field>
			<Field id="graphicLine7" type="textfield" visibleBindingId="graphicLineLayout" visibleBindingValue="graphic8" alwaysUseInDialogHeightCalc="true"><Label>Line 7:</Label></Field>
			<Field id="graphicLine8" type="textfield" visibleBindingId="graphicLineLayout" visibleBindingValue="graphic8" alwaysUseInDialogHeightCalc="true"><Label>Line 8:</Label></Field>
			<Field id="graphicText" type="textfield" hidden="true"/><Field id="graphicX" type="textfield" defaultValue="0" hidden="true"/><Field id="graphicY" type="textfield" defaultValue="0" hidden="true"/>
			<Field id="alternateLine1" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="flash1,flash2,flash3,flash4" alwaysUseInDialogHeightCalc="true"><Label>Alternate line 1:</Label></Field>
			<Field id="alternateLine2" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="flash2,flash3,flash4" alwaysUseInDialogHeightCalc="true"><Label>Alternate line 2:</Label></Field>
			<Field id="alternateLine3" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="flash3,flash4" alwaysUseInDialogHeightCalc="true"><Label>Alternate line 3:</Label></Field>
			<Field id="alternateLine4" type="textfield" visibleBindingId="animationLayout" visibleBindingValue="flash4" alwaysUseInDialogHeightCalc="true"><Label>Alternate line 4:</Label></Field>
			<Field id="substitutionHelp" type="label" fontSize="small" fontColor="darkgray" alwaysUseInDialogHeightCalc="true"><Label>Variable and Device State Substitution is enabled for all fields. Use the format %%v:12345%% for variables and %%d:12345:someStateId%% for device states.</Label></Field>
			<Field id="clippingHelp" type="label" visibleBindingId="animationLayout" visibleBindingValue="static1,static2,static3,static4,flash1,flash2,flash3,flash4" alwaysUseInDialogHeightCalc="true"><Label>Static and Flash text wider than a display row is clipped to fit.</Label></Field>
			<Field id="marqueeDirection" type="menu" defaultValue="left" visibleBindingId="animationLayout" visibleBindingValue="marquee1,marquee2,marquee3,marquee4,virtualMarquee1,virtualMarquee2,virtualMarquee3,virtualMarquee4" alwaysUseInDialogHeightCalc="true"><Label>Direction:</Label><List><Option value="left">Left</Option><Option value="right">Right</Option></List></Field>
			<Field id="marqueeGap" type="textfield" defaultValue="3" visibleBindingId="animationLayout" visibleBindingValue="marquee1,marquee2,marquee3,marquee4,virtualMarquee1,virtualMarquee2,virtualMarquee3,virtualMarquee4" alwaysUseInDialogHeightCalc="true"><Label>Gap between repeats:</Label></Field>
			<Field id="marqueeInterval" type="textfield" defaultValue="0.4" visibleBindingId="animationLayout" visibleBindingValue="marquee1,marquee2,marquee3,marquee4,virtualMarquee1,virtualMarquee2,virtualMarquee3,virtualMarquee4" alwaysUseInDialogHeightCalc="true"><Label>Scroll interval (seconds):</Label></Field>
			<Field id="flashInterval" type="textfield" defaultValue="1.0" visibleBindingId="animationLayout" visibleBindingValue="flash1,flash2,flash3,flash4" alwaysUseInDialogHeightCalc="true"><Label>Alternate interval (seconds):</Label></Field>
			<Field id="backlight" type="textfield" defaultValue="1.0"><Label>Backlight (0.0–1.0):</Label></Field>
			<Field id="contrast" type="textfield" defaultValue="0.5"><Label>Contrast (0.0–1.0):</Label></Field>
		</ConfigUI>
	</Action>
	<Action id="lcdStopAnimation" deviceFilter="self.lcd" uiPath="DeviceActions">
		<Name>Stop and turn off LCD</Name>
		<CallbackMethod>lcdStopAnimation</CallbackMethod>
	</Action>
	<Action id="lcdSleep" deviceFilter="self.lcd" uiPath="DeviceActions">
		<Name>Put LCD to sleep</Name>
		<CallbackMethod>lcdSleep</CallbackMethod>
	</Action>
	<Action id="lcdWake" deviceFilter="self.lcd" uiPath="DeviceActions">
		<Name>Wake LCD</Name>
		<CallbackMethod>lcdWake</CallbackMethod>
	</Action>
</Actions>  
