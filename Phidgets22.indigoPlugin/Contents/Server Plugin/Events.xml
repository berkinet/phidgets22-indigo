<?xml version="1.0"?>
<Events>
    <SupportURL>https://github.com/berkinet/phidgets22-indigo</SupportURL>
    <Event id="deviceDetached" deviceFilter="self">
        <Name>Phidget device detached</Name>
        <Label>An Indigo Phidget device has been detached</Label>
           <ConfigUI>
            <Field id="indigoDevice" type="menu">
              <Label>Phidget Device</Label>
                <List class="self" method="getAttachCapableList"/>
            </Field>
            <Field id="detachDelay" type="textfield" defaultValue="0">
              <Label>Must remain detached (seconds):</Label>
              <Description>Delays this trigger and cancels it if the device reattaches first. Use 0 for immediate execution.</Description>
            </Field>
          </ConfigUI>
    </Event>
    <Event id="deviceAttached" deviceFilter="self">
        <Name>Phidget device attached</Name>
        <Label>An Indigo Phidget device has been attached</Label>
        <ConfigUI>
            <Field id="indigoDevice" type="menu">
              <Label>Phidget Device</Label>
                <List class="self" method="getAttachCapableList"/>
            </Field>
        </ConfigUI>
    </Event>
</Events>
